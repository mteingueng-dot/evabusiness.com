# Copier ce fichier en .env.local et remplir les valeurs (jamais publié).
# Clé secrète Stripe (tableau de bord Stripe > Développeurs > Clés API). sk_test_… pour les essais.
STRIPE_SECRET_KEY=
# Adresse publique du site (sert aux pages de retour après le paiement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Facultatif : identifiants des taux de taxe créés dans Stripe (TPS 5 %, TVQ 9,975 %).
STRIPE_TAUX_TPS=
STRIPE_TAUX_TVQ=
